# Copy to .env.local and fill from the DEV Supabase project
# (fbc-pittsgrove-dev -> Settings -> API Keys). Never use prod keys locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Tooling-only — `yarn supabase db push` and psql, not read by the app.
SUPABASE_DB_URL=

# REQUIRED — proxy.ts throws without it. The PROD Supabase project URL (not a
# key). Off-prod deployments upload roadmap attachments straight into the
# canonical prod project's storage, so the CSP needs this origin. Same in
# every environment.
NEXT_PUBLIC_CANONICAL_SUPABASE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3150

# Owner drift check (/admin/diagnostics) + canonical roadmap proxy: URL of the
# OTHER deployment + a shared secret identical on both.
SCHEMA_PEER_URL=
SCHEMA_PEER_SECRET=

# Bearer for /api/cron/keepalive (Vercel sends it). Same value everywhere.
CRON_SECRET=

# Transactional email (Resend - resend.com). Required for invites and resets.
# RESEND_FROM must be a sender on the ROOT domain verified in Resend, never the
# `send.` bounce subdomain.
RESEND_API_KEY=
RESEND_FROM=
# REQUIRED on every non-production environment (and locally). Every recipient
# is rewritten to this address, the real one shown in the subject.
EMAIL_DEV_REDIRECT=dev@thesoftwareeffect.com
